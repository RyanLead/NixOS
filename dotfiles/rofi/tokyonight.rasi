/**
 * Tokyo Night theme for rofi — borderless, translucent, frosted.
 * Frosting comes from the Hyprland layer_rule blur on namespace "rofi".
 */

* {
    bg           : rgba(36, 40, 59, 0.72);
    bg-row-hover : rgba(146, 116, 202, 0.32);
    fg           : #c0caf5ff;
    fg-dim       : #7982a9ff;
    accent       : #bb9af7ff;
    accent-blue  : #7dcfffff;

    background-color:            transparent;
    text-color:                  @fg;

    font: "JetBrainsMono Nerd Font 12";
}

window {
    background-color:            @bg;
    border:                      0px;
    border-radius:                20px;
    width:                        600px;
    location:                    center;
    x-offset:                    0px;
    y-offset:                    0px;
}

mainbox {
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
    spacing:                      10px;
    padding:                      18px;
}

inputbar {
    background-color:            transparent;
    text-color:                  @fg;
    border-radius:                0px;
    padding:                      6px 8px 14px 8px;
    spacing:                      8px;
    children:                    [ "prompt", "entry" ];
}

prompt {
    background-color:            transparent;
    text-color:                  @accent-blue;
    font:                        "JetBrainsMono Nerd Font 12";
}

entry {
    background-color:            transparent;
    text-color:                  @fg;
    placeholder:                 "Search...";
    placeholder-color:           @fg-dim;
    cursor:                       text;
}

message {
    background-color:            transparent;
    text-color:                  @fg;
    border-radius:                0px;
    padding:                      8px 12px;
}

listview {
    background-color:            transparent;
    columns:                      1;
    lines:                        6;
    spacing:                      2px;
    cycle:                        true;
    dynamic:                      true;
    scrollbar:                    false;
}

element {
    background-color:            transparent;
    text-color:                  @fg;
    border-radius:                12px;
    padding:                      10px 12px;
    spacing:                      10px;
    orientation:                  horizontal;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @fg;
}

element selected.normal {
    background-color:            @bg-row-hover;
    text-color:                  @accent;
    border:                      0px;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @fg;
}

element-icon {
    size:                         22px;
    vertical-align:               0.5;
}

element-text {
    text-color:                   inherit;
    vertical-align:               0.5;
}
